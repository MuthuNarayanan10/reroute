# ============================================================
# CORE — required. These 4 are enough to run the website + dashboard.
# ============================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:3000
DATABASE_URL=postgres://reroute:reroute@localhost:5432/reroute
REDIS_URL=redis://localhost:6379
# 32 random bytes (hex or base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it after stores are connected.
ENCRYPTION_KEY=
# Comma-separated admin API keys for the internal dashboard API (generate long random strings)
ADMIN_API_KEYS=
# Extra browser origins allowed to call the dashboard API (dev only). APP_URL is always allowed.
ALLOWED_ORIGINS=http://localhost:5173
# Built website + dashboard served by the API (npm run build:web)
WEB_DIST=web/dist

# ============================================================
# INTEGRATIONS — optional at first. Each one switches on when its keys are set
# (check https://<your-site>/ready). See DEPLOY.md stage B.
# ============================================================

# --- Shopify (Partner dashboard -> App -> API credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_products,read_customers,read_checkouts
SHOPIFY_API_VERSION=2026-07

# --- Razorpay (payment links for prepaid conversion + ReRoute offers) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PREPAID=cod_to_prepaid_offer
WHATSAPP_TEMPLATE_REROUTE=nearby_parcel_offer
WHATSAPP_TEMPLATE_CART=abandoned_cart_reminder

# --- Courier (first adapter: Shiprocket) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
COURIER_WEBHOOK_SECRET=

# --- ReRoute tuning ---
REROUTE_RADIUS_KM=10
REROUTE_DISCOUNT_BPS=1000
REROUTE_OFFER_TTL_MINUTES=240
REROUTE_MAX_CANDIDATES=5
