{
  "name": "reroute-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI commerce platform for Indian D2C sellers: order sync, COD-to-prepaid, ReRoute parcel rescue",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/workers/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-pincodes": "tsx scripts/load-pincodes.ts",
    "test:integration": "INTEGRATION_DATABASE_URL=${INTEGRATION_DATABASE_URL:-postgres://reroute:reroute@localhost:5432/reroute_test} vitest run tests/flow.int.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.1",
    "bullmq": "^5.30.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
